{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "module": "esnext", "moduleResolution": "bundler", "isolatedModules": true,
    "jsx": "react-jsx", "resolveJsonModule": true,
    "paths": { "@/*": ["./*"] },
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
